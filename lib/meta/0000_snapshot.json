  "views": {
    "public.v_bugungi_reja": {
      "name": "v_bugungi_reja",
      "schema": "public",
      "columns": {
        "store_id": {
          "name": "store_id",
          "type": "bigint",
          "primaryKey": false,
          "notNull": false
        },
        "code": {
          "name": "code",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "region": {
          "name": "region",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "owner_id": {
          "name": "owner_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": false
        },
        "oxirgi_vizit": {
          "name": "oxirgi_vizit",
          "type": "timestamp with time zone",
          "primaryKey": false,
          "notNull": false
        },
        "kun_otdi": {
          "name": "kun_otdi",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        },
        "visit_every_days": {
          "name": "visit_every_days",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        }
      },
      "isExisting": false,
      "definition": "SELECT s.id AS store_id, s.code, s.region, s.owner_id, max(v.visited_at) AS oxirgi_vizit, COALESCE(date_part('day'::text, now() - max(v.visited_at))::integer, 999) AS kun_otdi, s.visit_every_days FROM stores s LEFT JOIN visits v ON v.store_id = s.id WHERE s.active GROUP BY s.id HAVING COALESCE(date_part('day'::text, now() - max(v.visited_at))::integer, 999) >= s.visit_every_days",
      "materialized": false
    },
    "public.v_manager_kunlik": {
      "name": "v_manager_kunlik",
      "schema": "public",
      "columns": {
        "manager_id": {
          "name": "manager_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": false
        },
        "full_name": {
          "name": "full_name",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "kun": {
          "name": "kun",
          "type": "timestamp with time zone",
          "primaryKey": false,
          "notNull": false
        },
        "vizitlar": {
          "name": "vizitlar",
          "type": "bigint",
          "primaryKey": false,
          "notNull": false
        },
        "buyurtmalar": {
          "name": "buyurtmalar",
          "type": "bigint",
          "primaryKey": false,
          "notNull": false
        },
        "yigilgan_pul": {
          "name": "yigilgan_pul",
          "type": "numeric",
          "primaryKey": false,
          "notNull": false
        }
      },
      "isExisting": false,
      "definition": "SELECT u.id AS manager_id, u.full_name, date_trunc('day'::text, v.visited_at) AS kun, count(v.id) AS vizitlar, count(*) FILTER (WHERE v.took_order) AS buyurtmalar, sum(v.cash_collected) AS yigilgan_pul FROM users u LEFT JOIN visits v ON v.manager_id = u.id WHERE u.role = 'sotuv_manager'::user_role GROUP BY u.id, u.full_name, (date_trunc('day'::text, v.visited_at))",
      "materialized": false
    },
