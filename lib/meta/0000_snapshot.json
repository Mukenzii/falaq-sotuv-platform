      "definition": "SELECT b.title, s.region, count(*) AS marta, max(v.visited_at) AS oxirgi FROM visit_books vb JOIN visits v ON v.id = vb.visit_id JOIN books b ON b.id = vb.book_id JOIN stores s ON s.id = v.store_id WHERE vb.status = 'stale'::book_status AND v.visited_at > (now() - '90 days'::interval) GROUP BY b.title, s.region ORDER BY (count(*)) DESC",
