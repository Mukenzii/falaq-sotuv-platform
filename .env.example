# Falaq Sotuv — configuration.
#
# LOCAL DEVELOPMENT
#   cp .env.example .env          # then fill in the Telegram and Google values
#   docker compose up -d          # postgres + minio
#   npm run dev
#
# PRODUCTION (the VDS)
#   cp .env.example .env.prod     # fill in REAL secrets, every one of them
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# The two files hold different variables. Development talks to containers on
# localhost and needs DATABASE_URL / MINIO_ENDPOINT; production builds those
# from the passwords below, because the services resolve by name on the compose
# network. Each block says which file it belongs in.
#
# Never commit .env or .env.prod. Both are in .gitignore.


# ─── Secrets you must generate ────────────────────────────────────────────────
# BOTH files. Signs the session cookie. Changing it logs everyone out.
#   openssl rand -hex 32
SESSION_SECRET=

# PRODUCTION ONLY. Postgres superuser (falaq_owner) and the app role.
# The app role is deliberately separate: it owns nothing, so RLS applies to it.
#   openssl rand -hex 24
DB_PASSWORD=
APP_DB_PASSWORD=

# PRODUCTION ONLY. MinIO root credentials, used for the photo bucket.
MINIO_USER=
MINIO_PASSWORD=


# ─── Telegram ─────────────────────────────────────────────────────────────────
# BOTH files. From @BotFather. This is the only way anyone signs in: they press
# START in the bot and an admin approves the request on /admin/sozlash.
# The bot needs no domain and no webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=falaqreaderbot
# Legacy, kept only so an older .env keeps working. The login flow is
# server-side now and reads TELEGRAM_BOT_USERNAME.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=


# ─── Database (DEVELOPMENT ONLY) ──────────────────────────────────────────────
# Port 5433, not 5432: a Homebrew postgres usually holds 5432 on a dev machine.
# In production these are assembled from DB_PASSWORD / APP_DB_PASSWORD instead.
DATABASE_URL=postgres://falaq_app:dev_only_change_me@localhost:5433/falaq
DATABASE_URL_OWNER=postgres://falaq_owner:dev_only_change_me@localhost:5433/falaq


# ─── Photo storage, MinIO (DEVELOPMENT ONLY) ──────────────────────────────────
# In production the app reaches MinIO at http://minio:9000 over the compose
# network; only MINIO_USER / MINIO_PASSWORD / MINIO_BUCKET are read there.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=falaq
MINIO_SECRET_KEY=dev_only_change_me
MINIO_BUCKET=falaq-photos


# ─── Google Sheets ────────────────────────────────────────────────────────────
# BOTH files. A service account, not OAuth: nothing here involves a browser or
# a consent screen.
#   1. console.cloud.google.com -> enable the Google Sheets API
#   2. create a service account -> Keys -> add a JSON key
#   3. share each spreadsheet below with the service account's email
#   4. turn the JSON into these two lines:
#        node -e "const j=require('./key.json');
#          console.log('GOOGLE_SERVICE_ACCOUNT_EMAIL='+j.client_email);
#          console.log('GOOGLE_PRIVATE_KEY='+JSON.stringify(j.private_key).slice(1,-1))"
# The key stays on one line with \n escapes; the app un-escapes it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Where visits are WRITTEN. Paste the whole URL from the address bar. The
# service account needs Editor on this one. Three tabs are rewritten on every
# push: vizitlar, vizit_kitoblar, bugungi_reja. Nothing else is touched.
SHEETS_SPREADSHEET_URL=
# ?gid=<n> picks the tab visits are written to (one row per visit, every form
# answer a column). Without it the tab "vizitlar" is created. Use ?gid=, not
# #gid= — an unquoted # starts a comment in .env and the tab is silently lost.
# The service account needs EDITOR on this spreadsheet.
# Older name for the same thing, still accepted. Leave empty if you set the URL.
SHEETS_SPREADSHEET_ID=

# Where the must-list (MML) is READ FROM — which books belong in which store,
# by ranking. Empty means "the same spreadsheet as above". Viewer is enough
# here; it is never written to.
MML_SHEET_URL=
MML_SHEET_TAB=MML
MML_BOOKS_TAB=Kitoblar

# Store directory: /dokon "Google Sheets'dan yangilash" reads these two tabs.
# Empty URL -> MML_SHEET_URL. The service account needs Viewer on the sheet.
STORES_SHEET_URL=
STORES_SHEET_TAB=Do'konlar yangi
STORES_GRADE_TAB=Do'konlar


# ─── Domain and serving ───────────────────────────────────────────────────────
# The domain this is served on.
DOMAIN=sotuv.falaq.uz

# This stack does NOT terminate TLS and does not touch 80 or 443 — the server
# already runs other projects behind its own proxy. It publishes exactly ONE
# port, on loopback, and that proxy forwards sotuv.falaq.uz to it.
# Pick anything free: 80, 443, 3000, 8000 and 8080 are taken on this server.
WEB_PORT=4300
# 127.0.0.1 keeps it off the public internet. Set 0.0.0.0 only if the proxy
# runs somewhere that cannot reach loopback (another host, or a container on a
# different docker network).
WEB_BIND=127.0.0.1

# Leave COOKIE_SECURE empty: the session cookie follows X-Forwarded-Proto, so
# it is Secure as long as your proxy sends that header. Set "true" only if it
# terminates TLS without sending one.
COOKIE_SECURE=

# Normally empty — it defaults to https://$DOMAIN. Photo storage is served as
# a path on the same origin, so there is no second host or port to configure.
MINIO_PUBLIC_ENDPOINT=

# Public address of the app (prod default https://${DOMAIN}): visit and photo links in the sheet.
APP_PUBLIC_URL=
