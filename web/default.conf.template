# sotuv.falaq.uz — the only way into the system.
#
# One origin in front of two containers: this nginx serves the built frontend,
# proxies /api to the app, and hands every page the SPA has not taken over back
# to the Next app.
#
# This container does NOT terminate TLS and does not own 80 or 443. The server
# already runs other projects behind its own proxy, so that proxy holds the
# certificate for sotuv.falaq.uz and forwards here over plain HTTP on one
# configurable port.
#
# Host and X-Forwarded-Proto must arrive untouched from that proxy: the MinIO
# upload signature covers the host, and the session cookie is marked Secure
# from the protocol. Getting either wrong breaks photo upload or login.

upstream app    { server ${APP_UPSTREAM}; }
upstream photos { server ${MINIO_UPSTREAM}; }

# The real client. Everything in front of this container is our own proxy, so
# $remote_addr is only ever that proxy — the browser is the first address in
# X-Forwarded-For.
map $http_x_forwarded_for $client_ip {
  default                $remote_addr;
  "~^([^,\s]+)"         $1;
}

# Signing in is the one endpoint worth guessing at. The per-account throttle in
# app/api/auth/login/route.ts slows somebody working through a single name; it
# cannot see attempts running side by side, and this is the half that can.
# 20/min with a burst of ten is far above what seven people typing a password
# from behind one office NAT will ever need.
limit_req_zone $client_ip zone=login:1m rate=20r/m;
limit_req_status 429;

# Keep the proxy's X-Forwarded-Proto if it sent one, else fall back to ours.
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  ""      $scheme;
}

server {
  listen 80 default_server;
  listen [::]:80 default_server;
  server_name ${DOMAIN} _;
  root /usr/share/nginx/html;

  client_max_body_size 25m;

  # nginx builds redirects as absolute URLs from server_name and its own listen
  # port, which loses the real public port behind a proxy. Relative ones
  # resolve against whatever the browser already has.
  absolute_redirect off;

  proxy_set_header Host              $http_host;
  proxy_set_header X-Real-IP         $remote_addr;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  # If the proxy in front sent one, keep it — that is how the app knows the
  # request reached the browser over https and marks the cookie Secure.
  proxy_set_header X-Forwarded-Proto $forwarded_proto;
  proxy_http_version 1.1;

  location = /api/auth/login {
    limit_req zone=login burst=10 nodelay;
    proxy_pass http://app;
  }

  # Answer a throttled sign-in in the shape the form already reads, so the
  # person sees why rather than a bare "Kirish amalga oshmadi".
  # recursive_error_pages is off by default, so this return is final.
  error_page 429 = @rate_limited;
  location @rate_limited {
    default_type application/json;
    return 429 '{"error":"Juda ko\u2018p urinish. Bir daqiqadan keyin qaytadan urinib ko\u2018ring."}';
  }

  location /api/ { proxy_pass http://app; }

  # content-hashed, so it can be cached hard
  location /assets/ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # Photo storage on the same origin, so it inherits the proxy's TLS and a
  # phone on an https page can PUT to it. Deliberately NOT rewritten: an S3
  # presigned URL signs the path /<bucket>/<key>, so MinIO has to receive that
  # exact path. Serving the bucket name as the location means the signed URL
  # and the upstream request are already identical.
  location /${MINIO_BUCKET}/ {
    proxy_pass http://photos;
    client_max_body_size 50m;
    proxy_buffering off;
    proxy_request_buffering off;
  }

  # routes the separated frontend has taken over
  location = /login { try_files /index.html =404; }

  # the SPA's copy of the MML page is gone; old links go to the real one
  location = /mml  { return 301 /admin/mml; }
  location = /mlrr { return 301 /admin/mml; }

  # everything not yet ported is still served by Next
  location / { proxy_pass http://app; }
}
